          "jsCode": "// Prueba del sandbox (task runner) de n8n 2.40.7\nconst out = {};\nout.cryptoGlobal = typeof crypto;\ntry { require('crypto'); out.requireCrypto = 'permitido'; } catch (e) { out.requireCrypto = 'bloqueado'; }\nout.buffer = Buffer.from('Palmera').toString('base64');\ntry {\n  const r = await this.helpers.httpRequest({ method: 'GET', url: 'http://127.0.0.1:5678/healthz', json: true, timeout: 5000 });\n  out.helpersHttp = r;\n} catch (e) { out.helpersHttp = 'error: ' + e.message; }\nconst h = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nout.texto = h('Prueba & <ok>') + '\\n\\nSiguiente paso: nada.';\nout.chat_id = 1;\nout.draft_id = 'drf-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 4);\nreturn [{ json: out }];"
