{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palmera Brava — data/site.json",
  "description": "Datos de la tienda, hero, categorías, lookbook, guía de tallas y plantillas de WhatsApp. Generado desde tools/validar.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "actualizado",
    "borradores_aplicados",
    "nombre",
    "lema",
    "whatsapp",
    "telefono_visible",
    "ciudad",
    "region",
    "pais",
    "direccion",
    "horario",
    "envio",
    "zonas_reparto",
    "metodos_pago",
    "redes",
    "mapa",
    "hero",
    "categorias",
    "lookbook",
    "testimonios",
    "guia_tallas",
    "mensajes",
    "temperatura_promedio",
    "asistente",
    "colecciones",
    "envios",
    "pagos",
    "textos"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^\\./schema/[a-z-]+\\.schema\\.json$"
    },
    "schema_version": {
      "const": 3,
      "description": "Versión del contrato (cambia solo si cambia el esquema). v2 desde 2026-10-07."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Revisión de los datos: WF5 la incrementa en cada commit. La web repinta si cambia."
    },
    "actualizado": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
      "description": "Fecha ISO 8601 con zona (-05:00) del último cambio publicado."
    },
    "borradores_aplicados": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^drf-[a-z0-9]{6,20}$"
      },
      "description": "Últimos 100 draft_id aplicados a site.json (idempotencia de WF5, D5)."
    },
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "pattern": "^[^<>]*$"
    },
    "lema": {
      "type": "string",
      "minLength": 2,
      "maxLength": 90,
      "pattern": "^[^<>]*$"
    },
    "whatsapp": {
      "type": "string",
      "pattern": "^(51\\d{9})?$",
      "description": "Formato wa.me: 51 + 9 dígitos, sin +, espacios ni guiones. Vacío = la web oculta los botones de pedido."
    },
    "telefono_visible": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[^<>]*$",
      "description": "Mismo número para mostrar, p. ej. \"+51 995 542 938\"."
    },
    "ciudad": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "pattern": "^[^<>]*$"
    },
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "pattern": "^[^<>]*$"
    },
    "pais": {
      "const": "PE"
    },
    "direccion": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "pattern": "^[^<>]*$",
      "description": "Sin dirección exacta mientras el dueño no la confirme."
    },
    "horario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto",
        "tramos"
      ],
      "properties": {
        "texto": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[^<>]*$"
        },
        "tramos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dias",
              "abre",
              "cierra"
            ],
            "properties": {
              "dias": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "lu",
                    "ma",
                    "mi",
                    "ju",
                    "vi",
                    "sa",
                    "do"
                  ]
                }
              },
              "abre": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "cierra": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            }
          }
        }
      }
    },
    "envio": {
      "type": "string",
      "minLength": 5,
      "maxLength": 400,
      "pattern": "^[^<>]*$"
    },
    "zonas_reparto": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60,
        "pattern": "^[^<>]*$"
      }
    },
    "metodos_pago": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "pattern": "^[^<>]*$"
      }
    },
    "anuncio": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^[^<>]*$",
      "description": "Opcional: barra de anuncio."
    },
    "redes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "red",
          "url"
        ],
        "properties": {
          "red": {
            "enum": [
              "instagram",
              "facebook",
              "tiktok",
              "youtube",
              "x"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^https://[^\\s<>\"'`]+$"
          }
        }
      }
    },
    "mapa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embed",
        "enlace",
        "lat",
        "lng"
      ],
      "properties": {
        "embed": {
          "type": "string",
          "maxLength": 400,
          "pattern": "^https://[^\\s<>\"'`]+$"
        },
        "enlace": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https://[^\\s<>\"'`]+$"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "nota": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[^<>]*$"
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imagenes"
      ],
      "properties": {
        "imagenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/imagen"
          }
        },
        "producto_destacado": {
          "type": "string",
          "pattern": "^prd-\\d{4,6}$",
          "description": "v3, opcional: producto de la portada (debe existir y estar activo)."
        },
        "etiqueta_destacado": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[^<>]*$",
          "description": "v3, opcional: etiqueta corta junto al producto de la portada."
        }
      }
    },
    "categorias": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "descripcion",
          "imagen",
          "subcategorias"
        ],
        "properties": {
          "id": {
            "enum": [
              "hombres",
              "mujeres",
              "ninos",
              "accesorios"
            ]
          },
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30,
            "pattern": "^[^<>]*$"
          },
          "descripcion": {
            "type": "string",
            "maxLength": 140,
            "pattern": "^[^<>]*$"
          },
          "imagen": {
            "$ref": "#/$defs/imagen"
          },
          "subcategorias": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/$defs/entrada_menu"
            },
            "description": "v3: menú de la categoría en orden. Sin \"etiqueta\" = subcategoría (filtra por producto.subcategoria = id); con \"etiqueta\" = colección (filtra por esa etiqueta dentro de la categoría). Ruta web: #/c/<categoria>/<id>."
          }
        }
      }
    },
    "colecciones": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/coleccion"
      },
      "description": "v3: colecciones transversales (p. ej. \"old money\"): agrupan productos por etiqueta. Ruta web: #/coleccion/<id>."
    },
    "temperatura_promedio": {
      "type": "string",
      "pattern": "^\\d{1,2}°$",
      "description": "v3: temperatura promedio de Tarapoto que muestra la web (p. ej. \"38°\")."
    },
    "asistente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nombre",
        "rol",
        "saludo",
        "acciones"
      ],
      "description": "v3: asistente virtual del chat de la web.",
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[^<>]*$"
        },
        "rol": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[^<>]*$"
        },
        "saludo": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "pattern": "^[^<>]*$"
        },
        "acciones": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 48,
            "pattern": "^[^<>]*$"
          },
          "description": "Chips de acción rápida del chat; la primera es \"Hacer seguimiento de mi pedido\"."
        }
      }
    },
    "envios": {
      "$ref": "#/$defs/envios"
    },
    "pagos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mercadopago"
      ],
      "properties": {
        "mercadopago": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activo",
            "modo",
            "public_key"
          ],
          "properties": {
            "activo": {
              "type": "boolean",
              "description": "false = la web vuelve al pedido por WhatsApp."
            },
            "modo": {
              "enum": [
                "prueba",
                "produccion"
              ],
              "description": "Demo: \"prueba\" (Checkout Pro con cuentas y tarjetas de prueba)."
            },
            "public_key": {
              "type": "string",
              "pattern": "^((APP_USR|TEST)-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$",
              "description": "Opcional (vacío): no se usa al redirigir a init_point. NUNCA el Access Token: vive solo en la credencial n8n pbCredMercPago01."
            },
            "nota": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^<>]*$"
            }
          }
        }
      }
    },
    "textos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkout",
        "pedido",
        "seguimiento",
        "cuenta",
        "estados_pedido"
      ],
      "description": "v3: textos de las vistas de compra, seguimiento y cuenta.",
      "properties": {
        "checkout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "titulo",
            "paso_contacto",
            "paso_envio",
            "paso_pago",
            "nota_envio",
            "boton_pagar",
            "aviso_prueba",
            "guardar_datos",
            "privacidad"
          ],
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "paso_contacto": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "paso_envio": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "paso_pago": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "nota_envio": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "boton_pagar": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "aviso_prueba": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "guardar_datos": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "privacidad": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            }
          }
        },
        "pedido": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "titulo_pagado",
            "texto_pagado",
            "titulo_pendiente",
            "texto_pendiente",
            "titulo_rechazado",
            "texto_rechazado"
          ],
          "properties": {
            "titulo_pagado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "texto_pagado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "titulo_pendiente": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "texto_pendiente": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "titulo_rechazado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "texto_rechazado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            }
          }
        },
        "seguimiento": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "titulo",
            "intro",
            "boton",
            "no_encontrado",
            "ayuda"
          ],
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "intro": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "boton": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "no_encontrado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "ayuda": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            }
          }
        },
        "cuenta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "titulo",
            "intro",
            "vacio",
            "olvidar"
          ],
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "intro": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "vacio": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            },
            "olvidar": {
              "type": "string",
              "minLength": 2,
              "maxLength": 240,
              "pattern": "^[^<>]*$"
            }
          }
        },
        "estados_pedido": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pendiente_pago",
            "pagado",
            "preparando",
            "enviado",
            "listo_recojo",
            "entregado",
            "cancelado"
          ],
          "properties": {
            "pendiente_pago": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "pattern": "^[^<>]*$"
            },
            "pagado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "pattern": "^[^<>]*$"
            },
            "preparando": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "pattern": "^[^<>]*$"
            },
            "enviado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "pattern": "^[^<>]*$"
            },
            "listo_recojo": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "pattern": "^[^<>]*$"
            },
            "entregado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "pattern": "^[^<>]*$"
            },
            "cancelado": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "pattern": "^[^<>]*$"
            }
          },
          "description": "Nombre visible de cada estado del pedido."
        }
      }
    },
    "lookbook": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "imagen",
          "productos"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^look-\\d{1,3}$"
          },
          "titulo": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "pattern": "^[^<>]*$"
          },
          "descripcion": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[^<>]*$"
          },
          "imagen": {
            "$ref": "#/$defs/imagen"
          },
          "productos": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^prd-\\d{4,6}$"
            }
          }
        }
      }
    },
    "testimonios": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nombre",
          "texto",
          "fuente",
          "fecha",
          "verificado"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "pattern": "^[^<>]*$"
          },
          "texto": {
            "type": "string",
            "minLength": 5,
            "maxLength": 400,
            "pattern": "^[^<>]*$"
          },
          "fuente": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "pattern": "^[^<>]*$"
          },
          "fecha": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
          },
          "verificado": {
            "const": true
          }
        }
      },
      "description": "Solo testimonios REALES y verificados; nunca inventados."
    },
    "guia_tallas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titulo",
        "intro",
        "consejo_calor",
        "como_medir",
        "tablas"
      ],
      "description": "v2: guía de tallas (modal de la web, abierto desde cada prenda). Medidas del CUERPO en cm salvo que la columna diga otra cosa.",
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60,
          "pattern": "^[^<>]*$"
        },
        "intro": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^[^<>]*$"
        },
        "consejo_calor": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400,
          "pattern": "^[^<>]*$",
          "description": "Consejo para el calor (tallas holgadas)."
        },
        "ayuda": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^<>]*$",
          "description": "Opcional: texto final (p. ej. \"¿Dudas? Escríbenos por WhatsApp\")."
        },
        "como_medir": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "titulo",
              "texto"
            ],
            "properties": {
              "id": {
                "enum": [
                  "pecho",
                  "busto",
                  "cintura",
                  "cadera",
                  "largo",
                  "entrepierna",
                  "estatura",
                  "cabeza",
                  "pie"
                ],
                "description": "La web dibuja esta zona en la ilustración SVG."
              },
              "titulo": {
                "type": "string",
                "minLength": 2,
                "maxLength": 40,
                "pattern": "^[^<>]*$"
              },
              "texto": {
                "type": "string",
                "minLength": 5,
                "maxLength": 300,
                "pattern": "^[^<>]*$"
              }
            }
          }
        },
        "tablas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "categoria",
              "subcategorias",
              "titulo",
              "medidas",
              "columnas",
              "filas"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 40,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "categoria": {
                "enum": [
                  "hombres",
                  "mujeres",
                  "ninos",
                  "accesorios"
                ]
              },
              "subcategorias": {
                "type": "array",
                "minItems": 1,
                "maxItems": 18,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "polos",
                    "camisas",
                    "blusas",
                    "vestidos",
                    "faldas",
                    "shorts",
                    "pantalones",
                    "conjuntos",
                    "ropa-de-bano",
                    "pijamas",
                    "calzado",
                    "sandalias",
                    "sombreros",
                    "gorros",
                    "lentes",
                    "cinturones",
                    "bolsos",
                    "otros"
                  ]
                },
                "description": "Subcategorías a las que aplica (ver tablaDeTallas)."
              },
              "titulo": {
                "type": "string",
                "minLength": 3,
                "maxLength": 60,
                "pattern": "^[^<>]*$"
              },
              "medidas": {
                "type": "array",
                "maxItems": 9,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "pecho",
                    "busto",
                    "cintura",
                    "cadera",
                    "largo",
                    "entrepierna",
                    "estatura",
                    "cabeza",
                    "pie"
                  ]
                },
                "description": "Zonas de como_medir que explica esta tabla."
              },
              "columnas": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 30,
                  "pattern": "^[^<>]*$"
                }
              },
              "filas": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "pattern": "^[^<>]*$"
                  }
                },
                "description": "Cada fila tiene tantas celdas como columnas. La 1.ª celda es la talla como en el producto (UNICA se escribe \"Única\")."
              },
              "nota": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[^<>]*$"
              }
            }
          }
        }
      }
    },
    "mensajes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pedido",
        "consulta"
      ],
      "description": "Plantillas de WhatsApp. Marcadores: {nombre} {id} {url}.",
      "properties": {
        "pedido": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300,
          "pattern": "^[^<>]*$"
        },
        "consulta": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300,
          "pattern": "^[^<>]*$"
        }
      }
    }
  },
  "$defs": {
    "imagen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt",
        "origen"
      ],
      "description": "Imagen de sitio: assets/img/brand|lookbook|blog|placeholders/. ia_local permitido.",
      "properties": {
        "src": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^assets/img/(blog|lookbook|brand|placeholders)/[a-z0-9]+(-[a-z0-9]+)*\\.(webp|avif|jpg|jpeg|png|svg)$",
          "description": "Ruta RELATIVA dentro del repo; nunca URL externa."
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[^<>]*$",
          "description": "Texto alternativo en español que describe la imagen."
        },
        "origen": {
          "enum": [
            "foto",
            "ia_local",
            "placeholder"
          ],
          "description": "Metadato interno (la web no lo muestra): foto = foto real; ia_local = generada con IA local (sd-server); placeholder = ilustración provisional."
        },
        "ancho": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "alto": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        }
      }
    },
    "entrada_menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "orden"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Slug: una subcategoría permitida para la categoría o el id de una colección."
        },
        "nombre": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[^<>]*$"
        },
        "orden": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "etiqueta": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Solo en colecciones: etiqueta de producto que filtra (igual a la de site.colecciones)."
        }
      }
    },
    "coleccion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "descripcion",
        "etiqueta",
        "categorias"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "nombre": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[^<>]*$"
        },
        "descripcion": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[^<>]*$"
        },
        "etiqueta": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Los productos con esta etiqueta forman la colección."
        },
        "categorias": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hombres",
              "mujeres",
              "ninos",
              "accesorios"
            ]
          },
          "description": "Categorías en cuyo menú aparece."
        },
        "imagen": {
          "$ref": "#/$defs/imagen"
        }
      }
    },
    "envios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cobertura",
        "resumen",
        "despacho",
        "nota",
        "gratis_desde",
        "zonas",
        "opciones"
      ],
      "description": "v3: envíos a todo el Perú desde Tarapoto (web, chat Vale y bot usan estos datos).",
      "properties": {
        "cobertura": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[^<>]*$"
        },
        "resumen": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200,
          "pattern": "^[^<>]*$"
        },
        "despacho": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240,
          "pattern": "^[^<>]*$"
        },
        "nota": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[^<>]*$"
        },
        "gratis_desde": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 9999,
          "description": "Envío gratis cuando el subtotal llega a este monto (S/); null = nunca."
        },
        "zonas": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/zona_envio"
          }
        },
        "opciones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/opcion_envio"
          }
        }
      }
    },
    "zona_envio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "departamentos"
      ],
      "properties": {
        "id": {
          "enum": [
            "lima",
            "costa_norte",
            "costa_sur",
            "sierra",
            "selva",
            "tarapoto"
          ]
        },
        "nombre": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[^<>]*$"
        },
        "departamentos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Amazonas",
              "Áncash",
              "Apurímac",
              "Arequipa",
              "Ayacucho",
              "Cajamarca",
              "Callao",
              "Cusco",
              "Huancavelica",
              "Huánuco",
              "Ica",
              "Junín",
              "La Libertad",
              "Lambayeque",
              "Lima",
              "Loreto",
              "Madre de Dios",
              "Moquegua",
              "Pasco",
              "Piura",
              "Puno",
              "San Martín",
              "Tacna",
              "Tumbes",
              "Ucayali"
            ]
          }
        },
        "distritos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "pattern": "^[^<>]*$"
          },
          "description": "Solo zonas locales: la zona aplica a ESTOS distritos de sus departamentos (tiene prioridad)."
        }
      }
    },
    "opcion_envio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "descripcion",
        "entrega",
        "costo_desde",
        "tiempo_promedio",
        "tiempos",
        "activa"
      ],
      "properties": {
        "id": {
          "enum": [
            "shalom",
            "olva",
            "bus",
            "local"
          ]
        },
        "nombre": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[^<>]*$"
        },
        "descripcion": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240,
          "pattern": "^[^<>]*$"
        },
        "entrega": {
          "enum": [
            "agencia",
            "domicilio"
          ],
          "description": "agencia = el cliente recoge con DNI (pide agencia_destino); domicilio = pide direccion."
        },
        "costo_desde": {
          "type": "number",
          "minimum": 0,
          "maximum": 999,
          "description": "Tarifa plana nacional que se cobra en la demo (S/), salvo envío gratis."
        },
        "tiempo_promedio": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[^<>]*$",
          "description": "Resumen corto para el chat y el bot."
        },
        "tiempos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lima",
            "costa_norte",
            "costa_sur",
            "sierra",
            "selva",
            "tarapoto"
          ],
          "properties": {
            "lima": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[^<>]*$"
            },
            "costa_norte": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[^<>]*$"
            },
            "costa_sur": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[^<>]*$"
            },
            "sierra": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[^<>]*$"
            },
            "selva": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[^<>]*$"
            },
            "tarapoto": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[^<>]*$"
            }
          },
          "description": "Tiempo promedio por zona (texto, p. ej. \"2–3 días hábiles\"); null = esta opción no llega a esa zona."
        },
        "rastreo_url": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^https://[^\\s<>\"'`]+$",
          "description": "Opcional. {codigo} se reemplaza por el código de seguimiento."
        },
        "activa": {
          "type": "boolean"
        }
      }
    }
  }
}
