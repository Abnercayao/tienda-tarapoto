{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palmera Brava — data/articles.json",
  "description": "Blog por bloques (sin HTML ni Markdown). Generado desde tools/validar.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "actualizado",
    "borradores_aplicados",
    "articulos"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^\\./schema/[a-z-]+\\.schema\\.json$"
    },
    "schema_version": {
      "const": 3,
      "description": "Versión del contrato (cambia solo si cambia el esquema). v2 desde 2026-10-07."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Revisión de los datos: WF5 la incrementa en cada commit. La web repinta si cambia."
    },
    "actualizado": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
      "description": "Fecha ISO 8601 con zona (-05:00) del último cambio publicado."
    },
    "borradores_aplicados": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^drf-[a-z0-9]{6,20}$"
      },
      "description": "Últimos 100 draft_id aplicados a articles.json (idempotencia de WF5, D5)."
    },
    "articulos": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/articulo"
      }
    }
  },
  "$defs": {
    "articulo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "titulo",
        "resumen",
        "portada",
        "bloques",
        "productos_relacionados",
        "autor",
        "fecha",
        "activo",
        "muestra"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^art-\\d{4,6}$"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 90,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "titulo": {
          "type": "string",
          "minLength": 5,
          "maxLength": 110,
          "pattern": "^[^<>]*$"
        },
        "resumen": {
          "type": "string",
          "minLength": 20,
          "maxLength": 240,
          "pattern": "^[^<>]*$"
        },
        "portada": {
          "$ref": "#/$defs/imagen"
        },
        "bloques": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/bloque"
          }
        },
        "productos_relacionados": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^prd-\\d{4,6}$"
          }
        },
        "autor": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[^<>]*$"
        },
        "fecha": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
          "description": "Fecha de publicación."
        },
        "fecha_actualizacion": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "activo": {
          "type": "boolean"
        },
        "muestra": {
          "type": "boolean"
        }
      }
    },
    "bloque": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/bloque_parrafo"
        },
        {
          "$ref": "#/$defs/bloque_subtitulo"
        },
        {
          "$ref": "#/$defs/bloque_lista"
        },
        {
          "$ref": "#/$defs/bloque_cita"
        },
        {
          "$ref": "#/$defs/bloque_producto"
        }
      ]
    },
    "bloque_parrafo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "texto"
      ],
      "properties": {
        "tipo": {
          "const": "parrafo"
        },
        "texto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "pattern": "^[^<>]*$"
        }
      }
    },
    "bloque_subtitulo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "texto"
      ],
      "properties": {
        "tipo": {
          "const": "subtitulo"
        },
        "texto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^<>]*$"
        }
      }
    },
    "bloque_lista": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "items"
      ],
      "properties": {
        "tipo": {
          "const": "lista"
        },
        "ordenada": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^<>]*$"
          }
        }
      }
    },
    "bloque_cita": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "texto"
      ],
      "properties": {
        "tipo": {
          "const": "cita"
        },
        "texto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^[^<>]*$"
        },
        "autor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^<>]*$"
        }
      }
    },
    "bloque_producto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "ids"
      ],
      "properties": {
        "tipo": {
          "const": "producto"
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^prd-\\d{4,6}$"
          }
        }
      }
    },
    "imagen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt",
        "origen"
      ],
      "description": "Portada: assets/img/blog/ (o placeholders). ia_local permitido.",
      "properties": {
        "src": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^assets/img/(blog|lookbook|brand|placeholders)/[a-z0-9]+(-[a-z0-9]+)*\\.(webp|avif|jpg|jpeg|png|svg)$",
          "description": "Ruta RELATIVA dentro del repo; nunca URL externa."
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[^<>]*$",
          "description": "Texto alternativo en español que describe la imagen."
        },
        "origen": {
          "enum": [
            "foto",
            "ia_local",
            "placeholder"
          ],
          "description": "Metadato interno (la web no lo muestra): foto = foto real; ia_local = generada con IA local (sd-server); placeholder = ilustración provisional."
        },
        "ancho": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "alto": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        }
      }
    }
  }
}
