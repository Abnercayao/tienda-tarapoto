  "testimonios": [],
  "guia_tallas": {
    "titulo": "Guía de tallas",
    "intro": "Todas las medidas son de tu cuerpo, en centímetros, salvo el largo de la prenda. Mídete con una cinta métrica sobre ropa ligera y compara con la tabla de tu prenda.",
    "consejo_calor": "Para el calor de Tarapoto te recomendamos un calce holgado: si estás entre dos tallas, elige la mayor. La ropa suelta deja circular el aire y el lino o el algodón se sienten más frescos cuando no se pegan al cuerpo. El lino puede encoger un poco: lávalo con agua fría y sécalo a la sombra.",
    "ayuda": "¿Dudas con tu talla? Escríbenos por WhatsApp con tus medidas y te ayudamos a elegir.",
    "como_medir": [
      {
        "id": "pecho",
        "titulo": "Pecho",
        "texto": "Pasa la cinta por debajo de las axilas, por la parte más ancha del pecho, sin apretar y con la cinta horizontal."
      },
      {
        "id": "busto",
        "titulo": "Busto",
        "texto": "Mide alrededor de la parte más alta del busto, con la cinta recta por la espalda y los brazos relajados."
      },
      {
        "id": "cintura",
        "titulo": "Cintura",
        "texto": "Rodea la parte más estrecha de tu cintura, por encima del ombligo, sin meter la barriga."
      },
      {
        "id": "cadera",
        "titulo": "Cadera",
        "texto": "Con los pies juntos, mide alrededor de la parte más ancha de la cadera y los glúteos."
      },
      {
        "id": "largo",
        "titulo": "Largo de la prenda",
        "texto": "Es una medida de la prenda: desde el punto más alto del hombro hasta el borde inferior."
      },
      {
        "id": "estatura",
        "titulo": "Estatura",
        "texto": "Para niños: mide de pie, descalzo y con la espalda contra la pared, desde el piso hasta la coronilla."
      },
      {
        "id": "cabeza",
        "titulo": "Contorno de cabeza",
        "texto": "Pasa la cinta por la frente, un dedo por encima de las cejas y de las orejas, por la parte más ancha de la cabeza."
      },
      {
        "id": "pie",
        "titulo": "Largo del pie",
        "texto": "Apoya el talón contra la pared sobre una hoja, marca la punta del dedo más largo y mide en línea recta. Hazlo por la tarde, cuando el pie está más hinchado."
      }
    ],
